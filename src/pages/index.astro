---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

const startpages = [
  {
    title: "AYAYADASH - Anime Dashboard",
    description:
      "A new tab dashboard for anime fans. Enjoy beautiful anime scenery and inspirational anime quotes every time you open a new tab.",
    dateUpdated: 1726275600,
    chromeLink:
      "https://chromewebstore.google.com/detail/ayayadash-anime-dashboard/pcilmcebllafjnlpkbcigemnookkklai",
    image: {
      src: "https://lh3.googleusercontent.com/vnUF1qO9NrnJ7WY0NUmTKviMIFFw2X-GkttanztqlVQJVWH_sjcHKSqlLgI7D1KBCGVPdmIgR0-q3oWZeP4DDDfj_g=s1280-w1280-h800",
    },
    tags: [
      "Anime",
      "Random Wallpaper",
      "Customizable",
      "Minimalist",
      "Wallpaper",
      "Clock",
      "Weather",
      "To-Do List",
    ],
  },
  {
    title: "Casca Extension",
    description:
      "Casca Extension is a tool with ChatGPT for productivity and collaboration. Customize your new tab, create and share multiple spaces, and maintain a work-life balance with ease. ",
    dateUpdated: 1714698000,
    firefoxLink:
      "https://addons.mozilla.org/en-GB/firefox/addon/casca-new-tab/",
    chromeLink:
      "https://chromewebstore.google.com/detail/casca-new-tab-with-chatgp/nifaiikfnpnppeicpgannigjabpjdcmh",
    image: {
      src: "https://addons.mozilla.org/user-media/previews/full/299/299208.png?modified=1715149228",
    },
    tags: [
      "Modular",
      "Wallpaper",
      "Widgets",
      "Workspaces",
      "Bookmarks",
      "Folders",
      "Collaboration",
      "ChatGPT",
      "Weather",
      "Notes",
      "Search",
      "To-Do List",
      "Pomodoro Timer",
      "Sync",
      "Kanban",
      "Calendar",
    ],
  },
  {
    title: "nightTab",
    description:
      "A neutral new tab page accented with a chosen colour. Customise the layout, style, background and bookmarks",
    dateUpdated: 1633222800,
    firefoxLink: "https://addons.mozilla.org/en-US/firefox/addon/nighttab/",
    chromeLink:
      "https://chromewebstore.google.com/detail/nighttab/hdpcadigjkbcpnlcpbcohpafiaefanki",
    gitLink: "https://github.com/zombieFox/nightTab",
    websiteLink: "https://zombiefox.github.io/nightTab/",
    image: {
      src: "https://lh3.googleusercontent.com/QpFiIjiDeo3F4YdplWrRM3Qexp0aeR-5i8i1nOQYPr5CISsImQhj0Y8-3ZP9U7qjY9MPikWG3gTDE-LO-s1mtdqC=s1280-w1280-h800",
    },
    tags: [
      "Modular",
      "Wallpaper",
      "Widgets",
      "Bookmarks",
      "Folders",
      "Export/Import",
      "Clock",
      "Customizable",
      "Themes",
      "Search",
    ],
  },
];
---

<div id="card-grid" class="card-grid">
  {
    startpages.map((startpage) => (
      <Card
        title={startpage.title}
        description={startpage.description}
        dateUpdated={startpage.dateUpdated}
        image={startpage.image}
        firefoxLink={startpage.firefoxLink}
        chromeLink={startpage.chromeLink}
        gitLink={startpage.gitLink}
        websiteLink={startpage.websiteLink}
        tags={startpage.tags}
      />
    ))
  }
</div>
