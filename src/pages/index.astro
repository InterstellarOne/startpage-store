  function searchCards(filterKeywordString: string) {
    const grid = document.getElementById("card-grid") as HTMLElement;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".card"));
    const filterKeywordArray = filterKeywordString.toLowerCase().split(" ");
    cards.forEach((card) => (card.style.display = "none"));

    const filtered = cards.filter(
      (c) =>
        c.dataset.title?.includes(filterKeywordString) ||
        filterKeywordArray.every((keyword) =>
          c.dataset.desc?.includes(keyword),
        ) ||
        filterKeywordArray.every((keyword) =>
          c.dataset.tags?.includes(keyword),
        ),
    );

    filtered.forEach((card) => (card.style.display = ""));
  }
  // for each card, for each keyword, if it does not match the keyword, hide it

  window.addEventListener("sort-changed", (e) => {
    const event = e as CustomEvent<{ sort: string }>;
    sortCards(event.detail.sort);
  });

  window.addEventListener("search-changed", (e) => {
    const event = e as CustomEvent<{ search: string }>;
    searchCards(event.detail.search);
  });

  sortCards("latest");
</script>
