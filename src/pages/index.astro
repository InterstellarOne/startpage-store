---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Header from "../components/Header.astro";
import Search from "../components/Search.astro";
import { getCollection } from "astro:content";

const startpages = await getCollection("startpages");
---

<Layout>
  <header>
    <Header />
  </header>
  <Search />
  <div id="card-grid-container">
    <div id="card-grid" class="card-grid">
      {startpages.map((startpage) => <Card {...startpage.data} />)}
    </div>
  </div>
</Layout>

<script>
  const grid = document.getElementById("card-grid") as HTMLElement;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>(".card"));
  let lastSearch = "";
  // sorts the cards based on latest added, latest updated, or alphabetical.
  function sortCards(method: string) {
    cards.sort((a, b) => {
      switch (method) {
        case "latest":
          return Number(b.dataset.dateAdded) - Number(a.dataset.dateAdded);
        case "updated":
          return Number(b.dataset.dateUpdated) - Number(a.dataset.dateUpdated);
        case "title":
          return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "");
        default:
          return 0;
      }
    });

    cards.forEach((card) => grid.appendChild(card));
  }

  // search function; filters the title and description based on keywords,
  // and checks if all the tags in the keyword are found on each card.
  function searchCards(filterKeywordString: string) {
    const filterKeywordArray = filterKeywordString.toLowerCase().split(" ");
    cards.forEach((card) => (card.style.display = "none"));

    const filtered = cards.filter((c) => {
      const tags: string[] = c.dataset.tags?.split(" ") ?? [];
      return (
        c.dataset.title?.includes(filterKeywordString) ||
        filterKeywordArray.every((keyword) =>
          c.dataset.desc?.includes(keyword),
        ) ||
        filterKeywordArray.every((keyword) =>
          tags.some((tag: string) => tag.includes(keyword)),
        )
      );
    });

    filtered.forEach((card) => (card.style.display = ""));
  }

  function hideProprietary() {
    cards.forEach(
      (card) =>
        card.dataset.proprietary == "true" && (card.style.display = "none"),
    );
  }

  function showProprietary() {
    cards.forEach((card) => (card.style.display = ""));
    searchCards(lastSearch);
  }

  window.addEventListener("sort-changed", (e) => {
    const event = e as CustomEvent<{ sort: string }>;
    sortCards(event.detail.sort);
  });

  window.addEventListener("search-changed", (e) => {
    const event = e as CustomEvent<{ search: string }>;
    searchCards(event.detail.search);
    lastSearch = event.detail.search;
  });

  window.addEventListener("checkbox-changed", (e) => {
    const event = e as CustomEvent<{ checked: boolean }>;
    event.detail.checked ? showProprietary() : hideProprietary();
  });

  sortCards("latest");
</script>
