---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Header from "../components/Header.astro";
import Search from "../components/Search.astro";
import { getCollection } from "astro:content";

const startpages = await getCollection("startpages");
---

<Layout>
  <header>
    <Header />
  </header>
  <Search />
  <div id="card-grid-container">
    <div id="card-grid" class="card-grid">
      {startpages.map((startpage) => <Card {...startpage.data} />)}
    </div>
  </div>
</Layout>

<script>
  import { check } from "astro:schema";

  function sortCards(method: string) {
    const grid = document.getElementById("card-grid") as HTMLElement;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".card"));

    cards.sort((a, b) => {
      switch (method) {
        case "latest":
          return Number(b.dataset.dateAdded) - Number(a.dataset.dateAdded);
        case "updated":
          return Number(b.dataset.dateUpdated) - Number(a.dataset.dateUpdated);
        case "title":
          return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "");
        default:
          return 0;
      }
    });

    cards.forEach((card) => grid.appendChild(card));
  }

