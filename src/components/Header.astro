---
import "../styles/global.css";
import "../styles/header.css";
---

<div id="header-container">
  <div id="header-title-container">
    <img
      src="src/assets/logo.svg"
      height="42"
      width="42"
      alt="Logo"
      id="header-logo"
    />
    <h1 id="header-title" class="header-item fredoka-medium">
      Startpage Gallery
    </h1>
    <div id="header-spacer" class="header-item"></div>
  </div>
  <div id="header-right-container">
    <div id="header-links" class="header-item">
      <div id="header-submit">
        <a
          href="https://github.com/InterstellarOne/startpage-store/issues/new"
          target="_blank"
          class="header-link fredoka-medium"
          aria-label="Submit a Startpage"
        >
          Submit
          <svg
            width="48"
            height="48"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-square-plus-icon lucide-square-plus"
            xml:space="preserve"
            xmlns="http://www.w3.org/2000/svg"
            ><g
              style="fill:none;stroke:currentColor;stroke-width:1.59934;stroke-linecap:round;stroke-linejoin:round"
              stroke="none"
              ><path
                d="M6.998 2.2A4.804 4.804 0 0 0 2.2 7v10.003c0 .144.007.285.02.425h1.605a3.314 3.314 0 0 1-.027-.425V7c0-1.786 1.413-3.2 3.199-3.2h10.004c1.785 0 3.2 1.414 3.2 3.2v9.04a5.085 5.085 0 0 1 1.596.273V6.999A4.804 4.804 0 0 0 17.002 2.2z"
                style="baseline-shift:baseline;display:inline;…031M6.5 21A3.5 3.5 0 1 0 3 17.5a2.62 2.62 0 0 1-.708 1.792A1 1 0 0 0 3 21ZM11 10l3 3"
                style="display:inline;fill:none;fill-opacity:1;stroke:#000;stroke-width:1.63075;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:none;stroke-opacity:1"
                transform="scale(-1.47027 -1.5745) rotate(45 39.673 -39.69)"
              ></path></g
            ></svg
          >
        </a>
      </div>
      <a
        href="https://github.com/InterstellarOne/startpage-store"
        target="_blank"
        class="header-link"
        id="header-link-github"
        aria-label="Visit the GitHub"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="icon icon-tabler icons-tabler-outline icon-tabler-brand-github"
          ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
            d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"
          ></path></svg
        >
      </a>
    </div>
    <button id="theme-btn" class="header-item header-theme-switcher">
      <img
        src="src/assets/light.svg"
        height="32"
        width="32"
        alt="Theme Switcher"
      />
      {
        //theme === "light" ? "🌙" : "☀️"}
      }
    </button>

    <script>
      const button = document.getElementById("theme-btn");

      button?.addEventListener("click", () => {});
    </script>
  </div>
</div>
