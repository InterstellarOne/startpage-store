---
import "../styles/global.css";
import "../styles/header.css";
---

<div id="header-container">
  <div id="header-title-container">
    <img
      src="src/assets/logo2.svg"
      height="42"
      width="42"
      alt="Logo"
      id="header-logo"
    />
    <h1 id="header-title" class="header-item ubuntu-bold">Startpage Gallery</h1>
    <div id="header-spacer" class="header-item"></div>
  </div>
  <div id="header-right-container">
    <div id="header-links" class="header-item">
      <div id="header-submit">
        <a
          href="https://github.com/InterstellarOne/startpage-store/issues/new"
          target="_blank"
          class="header-link roboto-medium"
          aria-label="Submit a Startpage"
        >
          Submit
          <img
            src="src/assets/submit.svg"
            height="32"
            width="32"
            alt=""
            aria-hidden="true"
          />
        </a>
      </div>
      <a
        href="https://github.com/InterstellarOne/startpage-store"
        target="_blank"
        class="header-link"
        id="header-link-github"
        aria-label="Visit the GitHub"
      >
        <img
          src="src/assets/github.svg"
          height="32"
          width="32"
          alt=""
          aria-hidden="true"
        />
      </a>
    </div>
    <button id="theme-btn" class="header-item header-theme-switcher">
      <img
        src="src/assets/light.svg"
        height="32"
        width="32"
        alt="Theme Switcher"
      />
      {
        //theme === "light" ? "🌙" : "☀️"}
      }
    </button>

    <script>
      const button = document.getElementById("theme-btn");

      button?.addEventListener("click", () => {});
    </script>
  </div>
</div>
