---

<div class="header-container">
  <img src="../assets/logo.png" alt="Logo" class="logo" />
  <h1 class="header-title">Startpage.Store</h1>
  <div class="header-spacer"></div>
  <div class="header-links">
    <a
      href="https://github.com/InterstellarOne/startpage-store"
      target="_blank"
      class="header-link"
    >
      GitHub
    </a>
    <a
      href="https://github.com/InterstellarOne/startpage-store/issues"
      target="_blank"
      class="header-link"
    >
      Submit a Startpage
    </a>
  </div>
  <button id="theme-btn" class="header-theme-switcher">
    {theme === "light" ? "🌙" : "☀️"}
  </button>
</div>

<script>
  const button = document.getElementById("theme-btn");

  button?.addEventListener("click", () => {});
</script>
