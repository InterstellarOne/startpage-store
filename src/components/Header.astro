---
import "../styles/global.css";
import "../styles/header.css";
---

<div id="header-container">
  <div id="header-title-container">
    <img
      src="src/assets/logo2.svg"
      height="42"
      width="42"
      alt="Logo"
      id="header-logo"
    />
    <h1 id="header-title" class="header-item ubuntu-bold">startpage.store</h1>
    <div id="header-spacer" class="header-item"></div>
  </div>
  <div id="header-right-container">
    <div id="header-links" class="header-item">
      <a
        href="https://github.com/InterstellarOne/startpage-store/issues"
        target="_blank"
        class="header-link"
      >
        <img
          src="src/assets/submit.svg"
          height="32"
          width="32"
          alt="Submit Issue"
          aria-hidden="true"
        />
      </a>
      <a
        href="https://github.com/InterstellarOne/startpage-store"
        target="_blank"
        class="header-link"
      >
        <img
          src="src/assets/github.svg"
          height="32"
          width="32"
          alt="GitHub"
          aria-hidden="true"
        />
      </a>
    </div>
    <button id="theme-btn" class="header-item header-theme-switcher">
      {
        //theme === "light" ? "🌙" : "☀️"}
      }
    </button>

    <script>
      const button = document.getElementById("theme-btn");

      button?.addEventListener("click", () => {});
    </script>
  </div>
</div>
