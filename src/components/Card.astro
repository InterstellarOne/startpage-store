---
// src/components/Card.astro
import firefoxIcon from "../assets/firefoxbrowser.svg";
import chromeIcon from "../assets/chromewebstore.svg";
import safariIcon from "../assets/safari.svg";
import githubIcon from "../assets/github.svg";
import websiteIcon from "../assets/website.svg";
import "../styles/card.css";
import "../styles/index.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  firefoxLink?: string;
  chromeLink?: string;
  safariLink?: string;
  gitLink?: string;
  websiteLink?: string;
  dateUpdated: number;
  dateAdded: number;
  image: {
    src: string;
  };
  tags: string[];
  proprietary: boolean;
}

const {
  title,
  description,
  firefoxLink,
  chromeLink,
  safariLink,
  gitLink,
  websiteLink,
  dateUpdated,
  dateAdded,
  image,
  tags,
  proprietary,
} = Astro.props;
---

<div
  class="card"
  data-date-added={dateAdded}
  data-date-updated={dateUpdated}
  data-title={title.toLowerCase()}
  data-desc={description.toLowerCase()}
  data-tags={tags}
>
  <div
    class="image-card-container"
    style={`background-image: url(${image.src});`}
  >
    <div class="icon-links">
      {/*create a button for each link present*/}
      {
        firefoxLink && (
          <a
            href={firefoxLink}
            target="_blank"
            class="icon-link firefox"
            aria-label="Download extension for Firefox-based browsers"
          >
            <img src={firefoxIcon.src} alt="" aria-hidden="true" />
          </a>
        )
      }
      {
        chromeLink && (
          <a
            href={chromeLink}
            target="_blank"
            class="icon-link chrome"
            aria-label="Download extension for Chromium-based browsers"
          >
            <img src={chromeIcon.src} alt="" aria-hidden="true" />
          </a>
        )
      }
      {
        safariLink && (
          <a
            href={safariLink}
            target="_blank"
            class="icon-link safari"
            aria-label="Download extension for Safari"
          >
            <img src={safariIcon.src} alt="" aria-hidden="true" />
          </a>
        )
      }
      {
        gitLink && (
          <a
            href={gitLink}
            target="_blank"
            class="icon-link git"
            aria-label="View source code or installation instructions"
          >
            <img src={githubIcon.src} alt="" aria-hidden="true" />
          </a>
        )
      }
      {
        websiteLink && (
          <a
            href={websiteLink}
            target="_blank"
            class="icon-link website"
            aria-label="Visit website for this startpage"
          >
            <img src={websiteIcon.src} alt="" aria-hidden="true" />
          </a>
        )
      }
    </div>
  </div>
  <div class="desc-wrapper">
    <h3 class="roboto-semibold card-title">{title}</h3>
    <p class="roboto-regular card-description">{description}</p>
    <div class="card-footer">
      <div class="roboto-light card-tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <hr class="card-divider" />
      <div class="card-info">
        {
          proprietary ? (
            <div id="license-proprietary" class="license-type">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-alert-triangle"
              >
                <>
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M12 9v4" />
                  <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0" />
                  <path d="M12 16h.01" />
                </>
              </svg>
              <span class="license-text roboto-medium">Proprietary</span>
            </div>
          ) : (
            <div id="license-open-source" class="license-type">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-open-source"
              >
                <>
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M12 3a9 9 0 0 1 3.618 17.243l-2.193 -5.602a3 3 0 1 0 -2.849 0l-2.193 5.603a9 9 0 0 1 3.617 -17.244" />
                </>
              </svg>
              <span class="license-text roboto-medium">Open Source</span>
            </div>
          )
        }
        <h4 class="date-updated roboto-regular">
          Updated: {
            new Date(dateUpdated * 1000).toLocaleDateString("en-CA", {
              month: "long",
              day: "numeric",
              year: "numeric",
            })
          }
        </h4>
      </div>
    </div>
  </div>
</div>
