---
import "../styles/global.css";
import "../styles/search.css";
import { getCollection } from "astro:content";

const tagArray = await getCollection("tags");
const tags = tagArray.flatMap((item) => item.data.tags);
const uniqueTags = Array.from(new Set(tags));
---

<div id="search">
  <search id="search-row-1" class="search-row">
    <input
      type="search"
      id="startpage-search"
      placeholder="Search for titles, tags, or keywords"
      class="search-item fredoka-regular"
    />
    <select id="startpage-sort" class="search-item fredoka-regular">
      <option value="latest">Recently Added</option>
      <option value="updated">Recently Updated</option>
      <option value="stars">GitHub Stars</option>
      <option value="title">Alphabetical</option>
    </select>
  </search>
  <div id="search-row-2" class="search-row">
    <div id="search-prop" class="search-prop">
      <label for="includeProp" class="search-prop-label fredoka-regular"
        >Include proprietary startpages</label
      >
      <input
        type="checkbox"
        name="includeProp"
        id="search-prop-checkbox"
        class="search-prop-checkbox"
        checked="true"
      />
    </div>
    <div id="tag-list">
      {uniqueTags.map((uniqueTags) => <span class="tag">{uniqueTags}</span>)}
    </div>
  </div>
</div>

<script>
  const selectSort = document.getElementById(
    "startpage-sort",
  ) as HTMLSelectElement;
  const search = document.querySelector(
    "#startpage-search",
  ) as HTMLInputElement | null;
  const tags = document.querySelectorAll(".tag");

  selectSort?.addEventListener("change", () => {
    window.dispatchEvent(
      new CustomEvent("sort-changed", { detail: { sort: selectSort.value } }),
    );
  });

  const selectSearch = document.getElementById(
    "startpage-search",
  ) as HTMLSelectElement;

  selectSearch?.addEventListener("change", () => {
    window.dispatchEvent(
      new CustomEvent("search-changed", {
        detail: { search: selectSearch.value },
      }),
    );
  });

  const checkbox = document.getElementById(
    "search-prop-checkbox",
  ) as HTMLInputElement;

  checkbox?.addEventListener("change", () => {
    window.dispatchEvent(
      new CustomEvent("checkbox-changed", {
        detail: { checked: checkbox.checked },
      }),
    );
  });

  tags.forEach((tag) => {
    tag.addEventListener("click", () => {
      if (search) {
        search.value == ""
          ? (search.value = tag.textContent)
          : (search.value += " " + tag.textContent);
      }
      window.dispatchEvent(
        new CustomEvent("search-changed", {
          detail: { search: selectSearch.value },
        }),
      );
    });
  });
</script>
