---
import "../styles/global.css";
import "../styles/search.css";
---

<div id="search">
  <search id="search-row-1">
    <input
      type="search"
      id="theme-search"
      placeholder="Search for titles, tags, or keywords"
      class="search-item"
    />
    <svg
      class="search-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"
      ></circle></svg
    >
    <select id="theme-sort" class="search-item">
      <option value="latest">Recently Added</option>
      <option value="updated">Recently Updated</option>
      <option value="alphabetical">Alphabetical</option>
    </select>
    <div id="search-ai-desktop" class="search-ai">
      <label for="excludeAI" class="search-ai-label"
        >Exclude primarily AI generated startpages</label
      >
      <input type="checkbox" name="excludeAI" class="search-ai-checkbox" />
    </div>
  </search>
  <div id="search-row-2">
    <div id="tag-list"></div>
  </div>
</div>
