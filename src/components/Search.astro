---
import "../styles/global.css";
import "../styles/search.css";
import { getCollection } from "astro:content";

const tagArray = await getCollection("tags");
const tags = tagArray.flatMap((item) => item.data.tags);
const uniqueTags = Array.from(new Set(tags));
---

<div id="search">
  <search id="search-row-1" class="search-row">
    <div id="search-wrapper">
      <input
        type="search"
        id="startpage-search"
        placeholder="Search for titles, tags, or keywords"
        class="search-item quicksand-regular"
      />
      <button id="search-x" type="button">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="icon icon-tabler icons-tabler-outline icon-tabler-x"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M18 6l-12 12"></path>
          <path d="M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <select id="startpage-sort" class="search-item quicksand-regular">
      <option value="latest">Recently Added</option>
      <option value="updated">Recently Updated</option>
      <option value="stars">Repository Stars</option>
      <option value="title">Alphabetical</option>
    </select>
  </search>
  <div id="search-row-2" class="search-row">
    <div id="search-prop" class="search-prop">
      <label for="includeProp" class="search-prop-label quicksand-regular"
        >Include proprietary startpages</label
      >
      <input
        type="checkbox"
        name="includeProp"
        id="search-prop-checkbox"
        class="search-prop-checkbox"
        checked="true"
      />
    </div>
    <div id="tag-list">
      {uniqueTags.map((uniqueTags) => <span class="tag">{uniqueTags}</span>)}
    </div>
  </div>
  <button id="collapse-btn" type="button">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="lucide lucide-chevrons-down-up preview-icon"
      id="collapse-icon"
      ><path d="m7 20 5-5 5 5"></path><path d="m7 4 5 5 5-5"></path></svg
    >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="lucide lucide-chevrons-up-down preview-icon"
      id="expand-icon"
      ><path d="m7 15 5 5 5-5"></path><path d="m7 9 5-5 5 5"></path></svg
    >
  </button>
</div>

<script>
  const selectSort = document.getElementById(
    "startpage-sort",
  ) as HTMLSelectElement;
  const search = document.querySelector(
    "#startpage-search",
  ) as HTMLInputElement | null;
  const tags = document.querySelectorAll(".tag");

  selectSort?.addEventListener("change", () => {
    window.dispatchEvent(
      new CustomEvent("sort-changed", { detail: { sort: selectSort.value } }),
    );
  });

  const selectSearch = document.getElementById(
    "startpage-search",
  ) as HTMLSelectElement;

  selectSearch?.addEventListener("input", () => {
    window.dispatchEvent(
      new CustomEvent("search-changed", {
        detail: { search: selectSearch.value },
      }),
    );
  });

  const selectX = document.getElementById("search-x") as HTMLSelectElement;

  selectX?.addEventListener("click", () => {
    selectSearch.value = "";
    window.dispatchEvent(
      new CustomEvent("search-changed", {
        detail: { search: selectSearch.value },
      }),
    );
  });

  const checkbox = document.getElementById(
    "search-prop-checkbox",
  ) as HTMLInputElement;

  checkbox?.addEventListener("change", () => {
    window.dispatchEvent(
      new CustomEvent("checkbox-changed", {
        detail: { checked: checkbox.checked },
      }),
    );
  });

  const selectCollapse = document.getElementById("collapse-btn") as HTMLElement;
  const searchRow2 = document.getElementById("search-row-2") as HTMLElement;
  const collapseIcon = document.getElementById("collapse-icon") as HTMLElement;
  const expandIcon = document.getElementById("expand-icon") as HTMLElement;

  selectCollapse?.addEventListener("click", () => {
    if (searchRow2.style.display == "flex") {
      searchRow2.style.display = "none";
      collapseIcon.style.display = "none";
      expandIcon.style.display = "inline";
    } else if (searchRow2.style.display == "none") {
      searchRow2.style.display = "flex";
      collapseIcon.style.display = "inline";
      expandIcon.style.display = "none";
    } else {
      searchRow2.style.display = "none";
      collapseIcon.style.display = "none";
      expandIcon.style.display = "inline";
    }
  });

  tags.forEach((tag) => {
    tag.addEventListener("click", () => {
      if (search) {
        search.value == ""
          ? (search.value = tag.textContent)
          : (search.value += " " + tag.textContent);
      }
      window.dispatchEvent(
        new CustomEvent("search-changed", {
          detail: { search: selectSearch.value },
        }),
      );
    });
  });
</script>
