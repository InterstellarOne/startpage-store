---
import "../styles/global.css";
import "../styles/search.css";
import { getCollection } from "astro:content";

const tagArray = await getCollection("tags");
const tags = tagArray.flatMap((item) => item.data.tags);
const uniqueTags = Array.from(new Set(tags));
---

<div id="search">
  <search id="search-row-1" class="search-row">
    <input
      type="search"
      id="theme-search"
      placeholder="Search for titles, tags, or keywords"
      class="search-item"
    />
    <select id="theme-sort" class="search-item">
      <option value="latest">Recently Added</option>
      <option value="updated">Recently Updated</option>
      <option value="alphabetical">Alphabetical</option>
    </select>
  </search>
  <div id="search-row-2" class="search-row">
    <div id="search-prop" class="search-prop">
      <label for="includeProp" class="search-prop-label"
        >Include proprietary startpages</label
      >
      <input
        type="checkbox"
        name="includeProp"
        class="search-prop-checkbox"
        checked="true"
      />
    </div>
    <div id="tag-list">
      {uniqueTags.map((uniqueTags) => <span class="tag">{uniqueTags}</span>)}
    </div>
  </div>
</div>
